<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- backend เป็นคนละ IIS site กับ frontend จึงต้องปิด WebDAV ซ้ำที่นี่อีกที
         (frontend/public/web.config ปิดไว้แล้วแต่มีผลแค่ site ตัวเอง) ARR rewrite
         /api/* มาลงที่ site นี้ ถ้า WebDAVModule ยัง active จะดัก PUT/DELETE
         คาย 405 + Allow: GET, HEAD, OPTIONS, TRACE ก่อนถึง AspNetCoreModuleV2
         -> Kestrel เสมอ ไม่ว่า controller จะมี [HttpPut] หรือไม่
         หมายเหตุ: ไม่ต้องใส่ <aspNetCore> / handler เอง — dotnet publish จะ merge
         ส่วนนั้นเข้ากับไฟล์นี้ให้ตอน build -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <security>
      <requestFiltering>
        <verbs applyToWebDAV="false">
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
