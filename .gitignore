# ==========================================
# 🛑 Node / Frontend Ignore Rules
# ==========================================
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
*.local
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# ==========================================
# 🛑 .NET / C# / Backend Ignore Rules
# ==========================================
**/bin/
**/obj/
**/TestResults/
**/.vs/
**/.vscode/
**/.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
*.trx
*.coverage
*.coveragexml

# ==========================================
# 🛑 SQLite & Database Files
# ==========================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db-journal

# ==========================================
# 🛑 Environment & Secrets
# ==========================================
.env
.env.*
!.env.example
*.secret.json
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.local.json
secrets.json
*.key
*.pem
*.cert
*.pfx

# ==========================================
# 🛑 Uploaded Media & Temporary Logs
# ==========================================
**/wwwroot/uploads/signatures/*
!**/wwwroot/uploads/signatures/.gitkeep
**/wwwroot/uploads/audit_images/*
!**/wwwroot/uploads/audit_images/.gitkeep
**/wwwroot/uploads/cap_images/*
!**/wwwroot/uploads/cap_images/.gitkeep
**/wwwroot/uploads/temp/*
!**/wwwroot/uploads/temp/.gitkeep
**/public/uploads/*
!**/public/uploads/.gitkeep
*.log
logs/

# ==========================================
# 🛑 OS / System / IDE Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.bak

# ==========================================
# 🛑 Exports & Archives
# ==========================================
qsc-clean-source/
*.zip
qsc-code.zip
*.tar.gz
*.rar
*.7z

# ==========================================
