# ==========================================
# 🛑 Node / Frontend Ignore Rules
# ==========================================
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
*.local
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 🛑 .NET / C# / Backend Ignore Rules
# ==========================================
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# ==========================================
# 🛑 SQLite & Database Files
# ==========================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ==========================================
# 🛑 Uploaded Media & Temporary Logs
# ==========================================
**/wwwroot/uploads/signatures/*
!**/wwwroot/uploads/signatures/.gitkeep
**/wwwroot/uploads/audit_images/*
!**/wwwroot/uploads/audit_images/.gitkeep
**/wwwroot/uploads/cap_images/*
!**/wwwroot/uploads/cap_images/.gitkeep
*.log

# ==========================================
# 🛑 Exports & Clean Archives
# ==========================================
qsc-clean-source/
*.zip
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 🛑 Local Secrets & Config Overrides
# ==========================================
**/appsettings.Development.json
*.secret.json


